---
import type { MarkdownInstance, PaginateFunction, Page } from 'astro'
import type { Frontmatter } from '@config'
import { SiteMetadata, PAGE_SIZE } from '@config'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import BlogList from '@components/blog/BlogList.astro'
import BlogPagination from '@components/blog/BlogPagination.astro'

export interface Props {
  page: Page<MarkdownInstance<Frontmatter>>
}

const { tag } = Astro.params
const { page } = Astro.props

const frontmatter: Frontmatter = {
  title: 'Tag: ' + tag + (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description:
    'Showing articles ' +
    (page.start + 1) +
    '-' +
    (page.end + 1) +
    ' (total ' +
    page.total +
    ')',
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  socialImage: undefined,
  publishDate: SiteMetadata.buildTime,
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allPosts = (await Astro.glob(
    '../../blog/*.{md,mdx}'
  )) as MarkdownInstance<Frontmatter>[]
  const posts = allPosts
    .sort(
      (a, b) =>
        new Date(b.frontmatter.publishDate).valueOf() -
        new Date(a.frontmatter.publishDate).valueOf()
    )
    .filter(post => !post.frontmatter.draft)

  const tags = Array.from(new Set(posts.flatMap(post => post.frontmatter.tags)))

  return tags.map(tag => {
    return paginate(posts.filter(post => tag && post.frontmatter.tags?.includes(tag)), {
      params: { tag },
      pageSize: PAGE_SIZE
    })
  })
}
---

<Layout frontmatter={frontmatter}>
  <Section class="bg-muted-100 dark:bg-muted-900">
    <Container>
      <BlogList title={`Tagged with '${tag}'`} subtitle="You can find all the posts that are associated with the tag you've selected below. Tags act as a way to mark posts and classify them based on the kind of information they provide." posts={page.data} />
      <BlogPagination page={page} />
    </Container>
  </Section>
</Layout>
