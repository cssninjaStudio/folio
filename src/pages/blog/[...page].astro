---
import type { PaginateFunction, Page } from 'astro'
import { SiteMetadata, PAGE_SIZE } from '@config'
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import BlogList from '@components/blog/BlogList.astro'
import BlogPagination from '@components/blog/BlogPagination.astro'

export interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props

const frontmatter = {
  title: 'Blog' + (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description: 'Showing articles ' + (page.start + 1) + '-' + (page.end + 1) + ' (total ' + page.total + ')',
  coverImage: '/svg/illustrations/scenes/draw-1.svg',
  socialImage: undefined,
  publishDate: SiteMetadata.buildTime,
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

  return paginate(posts, { pageSize: PAGE_SIZE })
}
---

<Layout frontmatter={frontmatter}>
  <Section class="bg-muted-100 dark:bg-muted-900">
    <Container>
      <BlogList
        title="All Posts"
        subtitle="Stay up-to-date with the most engaging and thought-provoking articles in our articles section: your go-to destination for quality content"
        posts={page.data}
      />
      <BlogPagination page={page} />
    </Container>
  </Section>
</Layout>
