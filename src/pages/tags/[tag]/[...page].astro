---
import type { PaginateFunction, Page } from 'astro'
import { SiteMetadata, authorDetail, PAGE_SIZE } from '@config'
import { getCollection, type CollectionEntry } from 'astro:content';
import { slug } from 'github-slugger'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import BlogList from '@components/blog/BlogList.astro'
import BlogPagination from '@components/blog/BlogPagination.astro'

export interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { tag } = Astro.params
const { page } = Astro.props

const frontmatter = {
  title: 'Tag: ' + tag + (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description:
    'Showing articles ' +
    (page.start + 1) +
    '-' +
    (page.end + 1) +
    ' (total ' +
    page.total +
    ')',
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  socialImage: undefined,
  publishDate: SiteMetadata.buildTime,
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) =>
      b.data.publishDate.valueOf() -
      a.data.publishDate.valueOf()
  );

  const tags = posts.reduce((acc, post) => {
    post.data.tags?.forEach((tag) => {
      if (!acc.includes(tag)) {
        acc.push(tag);
      }
    });
    return acc;
  }, [] as string[]);

  return tags.map(tag => {
    return paginate(posts.filter(post => tag && post.data.tags?.includes(tag)), {
      params: { tag: slug(tag) },
      pageSize: PAGE_SIZE
    })
  })
}
---

<Layout frontmatter={frontmatter}>
  <Section class="bg-muted-100 dark:bg-muted-900">
    <Container>
      <BlogList title={`Tagged with '${tag}'`} subtitle="You can find all the posts that are associated with the tag you've selected below. Tags act as a way to mark posts and classify them based on the kind of information they provide." posts={page.data} />
      <BlogPagination page={page} />
    </Container>
  </Section>
</Layout>
