---
import { getCollection, type CollectionEntry } from 'astro:content'
import { authorDetail } from '@config'
import { SiteMetadata } from '@config'
import { slug } from 'github-slugger'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'

const frontmatter: CollectionEntry<'blog'>['data'] = {
  title: 'Authors',
  description: 'Our famous and great authors',
  coverImage: '/svg/illustrations/scenes/draw-1.svg',
  publishDate: SiteMetadata.buildTime,
}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

const authors = posts.reduce((acc, post) => {
  if (post.data.author && !acc.includes(post.data.author)) {
    acc.push(post.data.author)
  }
  return acc
}, [] as string[])
---

<Layout frontmatter={frontmatter}>
  <Section class="min-h-screen bg-muted-100 dark:bg-muted-900">
    <Container>
      <div class="pt-20">
        <div class="max-w-lg ptablet:max-w-md md:max-w-xl space-y-2 mb-10">
          <h2 class="font-sans font-medium text-4xl text-muted-700 dark:text-white">Our Authors</h2>
          <p class="font-sans ptablet:text-sm text-muted-500 dark:text-muted-400">
            Meet the minds behind our exceptional content in our featured authors section: a showcase of talented writers and their unique perspectives
          </p>
        </div>
        <div class="relative">
          <div class="mt-6 grid sm:grid-cols-2 ltablet:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              authors.map(author => (
                <div class="relative">
                  <div class="p-6 rounded-lg border border-muted-200 dark:border-muted-700 bg-white dark:bg-muted-800">
                    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
                      <div class="h-14 w-14">
                        <img src={authorDetail(author).image} alt={author} class="w-full h-full object-center object-cover rounded-full" />
                      </div>
                      <div class="relative">
                        <h3 class="font-sans font-medium text-lg leading-none text-muted-800 dark:text-muted-100">
                          <a href={`/authors/${slug(author)}/`}>
                            <span class="absolute inset-0" />
                            {author}
                          </a>
                        </h3>
                        <p class="font-sans text-sm text-muted-400">{authorDetail(author).description}</p>
                      </div>
                      <div class="sm:ml-auto">
                        <a
                          href={`/authors/${slug(author)}/`}
                          class="w-52 sm:w-auto inline-flex items-center justify-center h-10 px-4 rounded-lg border border-muted-200 hover:border-primary-500 dark:border-muted-600 dark:hover:border-primary-500 bg-white dark:bg-muted-700 dark:hover:bg-primary-500 font-sans font-medium text-sm text-muted-600 hover:text-primary-500 dark:text-muted-400 dark:hover:text-white transition-colors duration-300"
                        >
                          Details
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
