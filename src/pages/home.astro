---
import { SiteMetadata } from '@config'
import { getCollection } from 'astro:content';
import Layout from '@layouts/Default.astro'
import BlogHeader from '@components/blog/BlogHeader.astro'
import BlogCategoriesFeatured from '@components/blog/BlogCategoriesFeatured.astro'
import BlogPostsFeatured from '@components/blog/BlogPostsFeatured.astro'
import BlogAuthorsFeatured from '@components/blog/BlogAuthorsFeatured.astro'
import BlogSummary from '@components/blog/BlogSummary.astro'
import Subscribe from '@components/content/Subscribe.astro'

const frontmatter = {
  title: SiteMetadata.title,
  description: SiteMetadata.description,
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  socialImage: undefined,
  publishDate: SiteMetadata.buildTime,
}
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishDate.valueOf() -
    a.data.publishDate.valueOf()
);

const featuredPosts = posts
  .filter(post => post.data.featured)
---

<Layout frontmatter={frontmatter}>
  <BlogHeader posts={posts} />
  <BlogCategoriesFeatured />
  <BlogPostsFeatured posts={featuredPosts} />
  <BlogAuthorsFeatured />
  <BlogSummary posts={posts} />
  <Subscribe />
</Layout>
