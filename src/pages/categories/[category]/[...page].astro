---
import type { PaginateFunction, Page } from 'astro'
import { SiteMetadata, categoryDetail, PAGE_SIZE } from '@config'
import { getCollection, type CollectionEntry } from 'astro:content';
import { slug } from 'github-slugger'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import BlogList from '@components/blog/BlogList.astro'
import BlogPagination from '@components/blog/BlogPagination.astro'

export interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { category } = Astro.params
const { page } = Astro.props

const detail = categoryDetail(category as string)

const frontmatter = {
  title: 'Category: ' + category + (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description:
    detail.description + ' ' +
    'Showing articles ' +
    (page.start + 1) +
    '-' +
    (page.end + 1) +
    ' (total ' +
    page.total +
    ')',
  coverSVG: detail.coverSVG,
  socialImage: detail.socialImage,
  publishDate: SiteMetadata.buildTime,
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) =>
      b.data.publishDate.valueOf() -
      a.data.publishDate.valueOf()
  );

  const categories = posts.reduce((acc, post) => {
    post.data.categories?.forEach((category) => {
      if (!acc.includes(category)) {
        acc.push(category);
      }
    });
    return acc;
  }, [] as string[]);

  return categories.map(category => {
    return paginate(posts.filter(post => category && post.data.categories?.includes(category)), {
      params: { category: slug(category) },
      pageSize: PAGE_SIZE
    })
  })
}
---

<Layout frontmatter={frontmatter}>
  <Section class="bg-muted-100 dark:bg-muted-900">
    <Container>
      <BlogList title={category} subtitle={`Find below all the posts related to the ${category} category. We hope that you'll quickly find what you've been looking for.`} posts={page.data} />
      <BlogPagination page={page} />
    </Container>
  </Section>
</Layout>
