---
import type { MarkdownInstance } from 'astro'
import type { Frontmatter } from '@config'
import { authorDetail } from '@config'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import Img from '@components/img.astro'
import SVGImg from '@components/svgimg.astro'

const frontmatter: Frontmatter = {
  title: 'Authors',
  description: 'Our famous and great authors',
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  socialImage: undefined,
  publishDate: '2022-08-08T00:00:00.000Z',
}

const allPosts = (await Astro.glob(
  './blog/*.{md,mdx}'
)) as MarkdownInstance<Frontmatter>[]
const posts = allPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.publishDate).valueOf() -
      new Date(a.frontmatter.publishDate).valueOf()
  )
  .filter(post => !post.frontmatter.draft)

const authors = Array.from(
  new Set(posts.flatMap(post => post.frontmatter.author))
)
---

<Layout frontmatter={frontmatter}>
  <Section class="min-h-screen bg-muted-100 dark:bg-muted-900">
    <Container>
      <div class="pt-20">
        <div class="max-w-lg ptablet:max-w-md md:max-w-xl space-y-2 mb-10">
          <h2
            class="font-sans font-medium text-4xl text-muted-700 dark:text-white"
          >
            Our Authors
          </h2>
          <p
            class="font-sans ptablet:text-sm text-muted-500 dark:text-muted-400"
          >
            Meet the minds behind our exceptional content in our featured
            authors section: a showcase of talented writers and their unique
            perspectives
          </p>
        </div>
        <div class="relative">
          <div
            class="mt-6 grid sm:grid-cols-2 ltablet:grid-cols-2 lg:grid-cols-3 gap-6"
          >
            {
              authors.map(author => (
                <div class="relative">
                  <div class="p-6 rounded-lg border border-muted-200 dark:border-muted-700 bg-white dark:bg-muted-800">
                    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
                      <div class="h-14 w-14">
                        {authorDetail(author).image !== undefined ? (
                          <Img
                            src={authorDetail(author).image}
                            alt={author}
                            class="w-full h-full object-center object-cover rounded-full"
                          />
                        ) : (
                          <SVGImg
                            src={authorDetail(author).svg}
                            alt={author}
                            class="w-full h-full object-center object-cover rounded-full"
                          />
                        )}
                      </div>
                      <div class="relative">
                        <h3 class="font-sans font-medium text-lg leading-none text-muted-800 dark:text-muted-100">
                          <a
                            href={`${
                              import.meta.env.BASE_URL
                            }author/${author}/`}
                          >
                            <span class="absolute inset-0" />
                            {author}
                          </a>
                        </h3>
                        <p class="font-sans text-sm text-muted-400">
                          {authorDetail(author).description}
                        </p>
                      </div>
                      <div class="sm:ml-auto">
                        <a
                          href={`${import.meta.env.BASE_URL}author/${author}/`}
                          class="w-52 sm:w-auto inline-flex items-center justify-center h-10 px-4 rounded-lg border border-muted-200 hover:border-primary-500 dark:border-muted-600 dark:hover:border-primary-500 bg-white dark:bg-muted-700 dark:hover:bg-primary-500 font-sans font-medium text-sm text-muted-600 hover:text-primary-500 dark:text-muted-400 dark:hover:text-white transition-colors duration-300"
                        >
                          Details
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
