---
import { Icon } from 'astro-icon'
import { SiteMetadata } from '@config'
import Layout from '@layouts/Default.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import Subscribe from '@components/content/Subscribe.astro'

const frontmatter = {
  title: 'About',
  description:
    'Hello, my name is Maya Piretti and I am a UI/er with 5 years of experience.',
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  publishDate: SiteMetadata.buildTime,
}
---

<Layout frontmatter={frontmatter}>
  <Section class="bg-muted-100 dark:bg-muted-1000 pb-0 overflow-hidden">
    <Container>
      <div class="flex flex-col ltablet:flex-row lg:flex-row ltablet:items-stretch lg:items-stretch">
        <div class="flex-1 flex items-center">
          <div class="max-w-md ptablet:mx-auto text-center ltablet:text-left lg:text-left pt-10 ltablet:pt-0 lg:pt-0">
            <h1
              class="font-sans text-4xl sm:text-5xl font-medium leading-tight text-muted-800 dark:text-white"
            >
              Hi, Iam Maya Piretti
            </h1>
            <h3
              class="py-2 font-sans font-medium uppercase text-base tracking-widest text-primary-500"
            >
              UI/UX Designer, Developer
            </h3>
            <p class="font-sans text-muted-500 dark:text-muted-400">
              Hello, my name is Maya Piretti and I am a UI/er with 5
              years of experience in creating intuitive and user-friendly
              digital products.
            </p>
          </div>
        </div>
        <div class="flex-1 flex flex-col items-end">
          <div class="relative w-full min-h-[390px] sm:min-h-[480px] flex flex-col justify-end">
            <img
              src="/img/illustrations/maya-full.svg"
              class="relative z-10 max-w-[240px] sm:max-w-[290px] mx-auto"
              alt="Freelancer profile"
            />
            <div
              class="absolute top-1/2 left-1/2 translate-x-[-55%] sm:translate-x-[-60%] -translate-y-1/3 h-[380px] w-[380px] mx-auto rounded-full bg-primary-500/20"
            >
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>
  <Section class="bg-white dark:bg-muted-900">
    <Container>
      <div class="grid grid-cols-12 gap-y-20 gap-x-16">
        <!-- Main -->
        <div class="col-span-12 ptablet:col-span-8 ltablet:col-span-8 lg:col-span-8">
          <div class="relative w-full max-w-2xl">
            <!-- Subsection -->
            <div class="space-y-14">
              <!--Overview-->
              <div>
                <h3
                  class="font-sans font-medium text-2xl text-muted-800 dark:text-white mb-4"
                >
                  About me
                </h3>
                <div class="space-y-6">
                  <p class="font-sans text-muted-500">
                    I am Maya Piretti, a highly skilled and experienced UI/UX
                    designer with over 5 years of experience in the industry. I
                    have a passion for creating intuitive and user-friendly
                    designs that not only look great, but also improve the
                    overall user experience.
                  </p>
                  <p class="font-sans text-muted-500">
                    I graduated from the Rhode Island School of Design with a
                    degree in Graphic Design, and have since worked with a
                    variety of clients, ranging from startups to large
                    corporations. I have a strong understanding of user-centered
                    design principles and am skilled in a variety of design
                    tools, including Sketch, Adobe XD, and InVision.
                  </p>
                  <p class="font-sans text-muted-500">
                    My design process is thorough and research-driven. I start
                    by conducting user research and creating personas to better
                    understand the needs of my target audience. I then create
                    wireframes and prototypes to test and iterate on my designs,
                    and finally, I create high-fidelity mockups that are used to
                    guide the development process.
                  </p>
                  <p class="font-sans text-muted-500">
                    I am a strong communicator and a collaborative team player.
                    I work closely with stakeholders and developers to ensure
                    that the final product meets the needs of the users and the
                    business. I am also a skilled problem solver and am able to
                    come up with creative solutions to complex design
                    challenges.
                  </p>
                </div>
              </div>
              <!--Design-->
              <div>
                <h3
                  class="font-sans font-medium text-2xl text-muted-800 dark:text-white mb-6"
                >
                  Design
                </h3>

                <ul class="space-y-4">
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      5+ years of experience in UI/, working with
                      clients across various industries, including e-commerce,
                      finance, and healthcare.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Strong understanding of user-centered design principles
                      and methodologies, with experience conducting user
                      research, creating personas, and designing user flows.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Proficient in design tools such as Sketch, Adobe XD, and
                      InVision, and experienced in creating wireframes,
                      prototypes, and high-fidelity mockups.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Collaborated with cross-functional teams, including
                      developers, product managers, and stakeholders, to ensure
                      the final product meets the needs of the users and the
                      business.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Led the redesign of a high-traffic e-commerce website,
                      resulting in a 20% increase in conversion rate.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Worked on a mobile app for a fintech startup, resulting in
                      a 30% increase in user retention.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Experience in designing for accessibility and inclusive
                      design.
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Strong communication and presentation skills, with
                      experience presenting designs to clients and stakeholders.
                    </p>
                  </li>
                </ul>
              </div>
              <!--Development-->
              <div>
                <h3
                  class="font-sans font-medium text-2xl text-muted-800 dark:text-white mb-6"
                >
                  Development
                </h3>

                <ul class="space-y-4">
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      4+ years of system administration experience with the
                      Microsoft Server platform (2012/2016, Microsoft IIS,
                      Active Directory)
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      3+ years of hands-on system administration experience with
                      AWS (EC2, Elastic Load Balancing, Multi AZ, etc.)
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      4+ years of SQL Server, MySQL
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Working knowledge of Encryption techniques and protocols,
                      Multi-factor authentication, Data protection, Penetration
                      testing, Security threats
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Bachelor’s Degree, or 4+ years of hands-on IT experience
                    </p>
                  </li>
                </ul>
              </div>
              <!--Skills-->
              <div>
                <h3
                  class="font-sans font-medium text-2xl text-muted-800 dark:text-white mb-6"
                >
                  Hobbies
                </h3>

                <ul class="space-y-4">
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Traveling and photography
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Sketching and drawing
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">Playing video games</p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Listening to music and podcast
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Playing sports or doing Yoga
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex gap-4">
                    <div
                      class="flex items-center justify-center h-7 w-7 min-w-[1.75rem] rounded-full bg-teal-100 dark:bg-teal-500 dark:text-white text-teal-500"
                    >
                      <Icon name="lucide:check" class="w-3 h-3" />
                    </div>
                    <p class="font-sans text-muted-500">
                      Cooking and trying new foods
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <!-- Meta -->
        <div class="col-span-12 ptablet:col-span-4 ltablet:col-span-4 lg:col-span-4">
          <div class="relative h-full w-full max-w-sm">
            <!--Skills-->
            <div class="space-y-8">
              <!--Item-->
              <div>
                <h3
                  class="font-sans font-semibold text-xs uppercase text-muted-500 dark:text-muted-400 mb-3"
                >
                  Experience
                </h3>
                <p class="font-sans text-muted-700 dark:text-muted-100">
                  5 years +
                </p>
              </div>
              <!--Item-->
              <div>
                <h3
                  class="font-sans font-semibold text-xs uppercase text-muted-500 dark:text-muted-400 mb-3"
                >
                  Role
                </h3>
                <p class="font-sans text-muted-700 dark:text-muted-100">
                  UI/UX Designer
                </p>
              </div>
              <!--Item-->
              <div>
                <h3
                  class="font-sans font-semibold text-xs uppercase text-muted-500 dark:text-muted-400 mb-3"
                >
                  Work status
                </h3>
                <p class="font-sans text-muted-700 dark:text-muted-100">
                  Freelance
                </p>
              </div>
            </div>

            <hr class="my-10 border-t border-muted-200 dark:border-muted-800" />

            <!--Main skills-->
            <div>
              <!--Item-->
              <div>
                <h3
                  class="font-sans font-semibold text-xs uppercase text-muted-500 dark:text-muted-400 mb-5"
                >
                  Main skills
                </h3>
                <ul class="space-y-4">
                  <!--Item-->
                  <li class="flex items-center gap-3">
                    <div
                      class="h-10 w-10 flex items-center justify-center bg-muted-200 dark:bg-muted-800 mask mask-blob"
                    >
                      <Icon name="logos:sketch" class="w-5 h-5" />
                    </div>
                    <p
                      class="font-sans font-medium text-sm text-muted-500 dark:text-muted-400"
                    >
                      Sketch
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex items-center gap-3">
                    <div
                      class="h-10 w-10 flex items-center justify-center bg-muted-200 dark:bg-muted-800 mask mask-blob"
                    >
                      <Icon class="w-5 h-5" name="logos:zeplin" />
                    </div>
                    <p
                      class="font-sans font-medium text-sm text-muted-500 dark:text-muted-400"
                    >
                      Zeplin
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex items-center gap-3">
                    <div
                      class="h-10 w-10 flex items-center justify-center bg-muted-200 dark:bg-muted-800 mask mask-blob"
                    >
                      <Icon class="w-5 h-5" name="logos:figma" />
                    </div>
                    <p
                      class="font-sans font-medium text-sm text-muted-500 dark:text-muted-400"
                    >
                      Figma
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex items-center gap-3">
                    <div
                      class="h-10 w-10 flex items-center justify-center bg-muted-200 dark:bg-muted-800 mask mask-blob"
                    >
                      <Icon class="w-5 h-5" name="logos:html-5" />
                    </div>
                    <p
                      class="font-sans font-medium text-sm text-muted-500 dark:text-muted-400"
                    >
                      HTML5
                    </p>
                  </li>
                  <!--Item-->
                  <li class="flex items-center gap-3">
                    <div
                      class="h-10 w-10 flex items-center justify-center bg-muted-200 dark:bg-muted-800 mask mask-blob"
                    >
                      <Icon class="w-5 h-5" name="logos:css-3" />
                    </div>
                    <p
                      class="font-sans font-medium text-sm text-muted-500 dark:text-muted-400"
                    >
                      CSS3
                    </p>
                  </li>
                </ul>
              </div>
            </div>

            <hr class="my-10 border-t border-muted-200 dark:border-muted-800" />

            <!--Sticky panel-->
            <div
              class="static ptablet:sticky ltablet:sticky lg:sticky inset-x-0 top-24 left-0 px-4 py-6 bg-white dark:bg-muted-800 border border-muted-200 dark:border-muted-700 rounded-xl shadow-xl shadow-muted-400/10 dark:shadow-muted-800/10"
            >
              <div class="text-3xl text-primary-400 mb-4">
                <div class="flex ptablet:flex-col ptablet:text-center items-center gap-2 lg:gap-4 mt-4 md:mt-0">
                  <div class="h-12 w-12 flex items-center justify-center">
                    <img
                      src="/img/illustrations/maya-small.svg"
                      class="w-full h-full mask mask-blob"
                      alt="Maya profile"
                    />
                  </div>
                  <div>
                    <h4
                      class="font-sans font-semibold text-lg text-muted-800 dark:text-muted-100"
                    >
                      UI/UX Designer
                    </h4>
                    <p class="font-sans text-sm text-muted-400">
                      Freelance · 5 years exp
                    </p>
