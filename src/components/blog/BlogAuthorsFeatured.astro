---
import type { MarkdownInstance } from 'astro'
import type { Frontmatter } from '@config'
import { authorDetail } from '@config'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import Img from '@components/img.astro'
import SVGImg from '@components/svgimg.astro'

const frontmatter: Frontmatter = {
  title: 'Authors',
  description: 'Contributors to this website',
  coverSVG: '../svg/illustrations/scenes/draw-1.svg',
  socialImage: '../images/posts/post-2.png',
  publishDate: '2022-08-08T00:00:00.000Z',
}

const allPosts = (await Astro.glob(
  '../../pages/blog/*.{md,mdx}'
)) as MarkdownInstance<Frontmatter>[]
const posts = allPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.publishDate).valueOf() -
      new Date(a.frontmatter.publishDate).valueOf()
  )
  .filter(post => !post.frontmatter.draft)

const authors = Array.from(
  new Set(posts.flatMap(post => post.frontmatter.author))
).slice(0, 5)
---

<Section class="bg-white dark:bg-muted-900 pb-0">
  <Container class="pb-20 border-b border-muted-200 dark:border-muted-800">
    <div class="relative">
      <div class="max-w-xl space-y-2 mb-10">
        <h2
          class="font-sans font-medium text-4xl text-muted-700 dark:text-white"
        >
          Featured authors
        </h2>
        <p class="font-sans text-muted-500 dark:text-muted-400">
          Meet the minds behind our exceptional content in our featured authors
          section: a showcase of talented writers and their unique perspectives
        </p>
      </div>
      <div class="relative">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-8">
          {
            authors.map(author => (
              <div class="group relative flex flex-col justify-center text-center">
                <div class="relative h-20 w-20 ptablet:h-24 ptablet:w-24 ltablet:h-24 ltablet:w-24 md:h-28 md:w-28 mx-auto mb-4">
                  {authorDetail(author).image !== undefined ? (
                    <Img
                      src={authorDetail(author).image}
                      alt={author}
                      class="w-full h-full object-center object-cover rounded-full"
                    />
                  ) : (
                    <SVGImg
                      src={authorDetail(author).svg}
                      alt={author}
                      class="w-full h-full object-center object-cover rounded-full"
                    />
                  )}
                </div>
                <h3 class="font-sans text-lg text-muted-800 dark:text-muted-100">
                  <a href={`${import.meta.env.BASE_URL}author/${author}/`}>
                    <span class="absolute inset-0" />
                    {author}
                  </a>
                </h3>
                <p class="font-sans text-sm text-muted-400">
                  {authorDetail(author).description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</Section>
