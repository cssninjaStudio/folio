---
import type { MarkdownInstance } from 'astro'
import { Icon } from 'astro-icon'
import type { Frontmatter } from '@config'
import { authorDetail } from '@config'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import SVGImg from '@components/svgimg.astro'
import Img from '@components/img.astro'

export interface Props {
  posts: MarkdownInstance<Frontmatter>[]
}

const { posts } = Astro.props

const headerPosts = posts.slice(0, 3)
---

<Section class="bg-white dark:bg-muted-900 pb-0">
  <Container>
    <div class="relative grid ptablet:grid-cols-2 md:grid-cols-3 gap-2 pt-4">
      {
        headerPosts.map(post => (
          <div class="relative overflow-hidden last:ptablet:hidden">
            <div class="relative">
              {post.frontmatter.coverSVG ? (
                <SVGImg
                  src={post.frontmatter.coverSVG}
                  alt={post.frontmatter.title + ' featured image'}
                  class="block w-full h-[420px] object-cover"
                />
              ) : (
                <Img
                  src={
                    post.frontmatter.coverImage || post.frontmatter.socialImage
                  }
                  alt={post.frontmatter.title + ' featured image'}
                  class="block w-full h-[420px] object-cover"
                />
              )}
            </div>
            <div class="absolute bottom-0 left-0 w-full h-2/3 z-10 bg-gradient-to-t from-muted-1000" />
            <div class="absolute top-0 left-0 w-full h-full z-20 flex flex-col justify-end">
              <div class="p-6">
                <div class="flex items-center gap-2 mb-1 mt-4 text-muted-100">
                  <Icon name="ph:calendar-blank-duotone" class="w-4 h-4" />
                  <p class="font-sans text-xs">
                    {post.frontmatter.publishDate?.slice(0, 10)}
                  </p>
                </div>
                <h3 class="font-sans font-light text-2xl ptablet:text-xl mb-2">
                  <a
                    href={post.url}
                    class="text-white hover:text-primary-300 transition-colors duration-300"
                  >
                    {post.frontmatter.title}
                  </a>
                </h3>
                <div class="flex items-center justify-between">
                  <div>
                    {post.frontmatter.author && (
                      <span class="flex items-center gap-2">
                        <a
                          href={`${import.meta.env.BASE_URL}author/${
                            post.frontmatter.author
                          }/`}
                          class="h-9 w-9 flex items-center justify-center shrink-0 rounded-full bg-white dark:bg-muted-800"
                        >
                          {authorDetail(post.frontmatter.author).image !== undefined ? (
                            <Img
                              src={authorDetail(post.frontmatter.author).image}
                              alt={post.frontmatter.author}
                              class="h-9 w-9 rounded-full object-cover scale-90"
                            />
                          ) : (
                            <SVGImg
                              src={authorDetail(post.frontmatter.author).svg}
                              alt={post.frontmatter.author}
                              class="h-9 w-9 rounded-full object-cover scale-90"
                            />
                          )}
                        </a>
                        <div>
                          <h4 class="font-sans text-sm">
                            <a
                              href={`${import.meta.env.BASE_URL}author/${
                                post.frontmatter.author
                              }/`}
                              class="text-white hover:text-primary-300 transition-colors duration-300"
                            >
                              {post.frontmatter.author}
                            </a>
                          </h4>
                        </div>
                      </span>
                    )}
                  </div>
                  <div class="font-sans text-sm text-muted-100">
                    <span class="pr-2">—</span>
                    <span>{post.frontmatter.minutesRead}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
