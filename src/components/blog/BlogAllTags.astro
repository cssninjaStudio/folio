---
import { getCollection, type CollectionEntry } from 'astro:content'
import type { TagType } from '@config'
import { slug } from 'github-slugger'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishDate.valueOf() -
    a.data.publishDate.valueOf()
);


const tagmap: Map<string, TagType> = new Map()

posts.forEach(post => {
  post.data.tags?.forEach(tag => {
    let utag = tagmap.get(tag)
    if (utag) {
      utag.count += 1
      utag.pages.push(post)
    } else {
      utag = { tag: tag, count: 1, pages: [post] }
    }
    tagmap.set(tag, utag)
  })
})

const tags = Array.from(tagmap.values())
---

<div class="relative pb-20 border-b border-muted-200 dark:border-muted-800">
  <div class="pt-10 sm:pt-20 mb-12">
    <div class="max-w-xl space-y-2">
      <h2 class="font-sans font-medium text-4xl text-muted-700 dark:text-white">
        All Tags
      </h2>
      <p
        class="font-sans text-sm lg:text-base text-muted-500 dark:text-muted-400"
      >
        Browse through our expertly curated tag markers and uncover new insights
        on the things you're interested in. Start exploring now!
      </p>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    {
      tags
        .sort((a, b) => b.count - a.count)
        .map((tag, i) => (
          <a href={`/tags/${slug(tag.tag)}/`} class="group">
            <div class="relative">
              <div class="flex gap-4 py-2 px-4 rounded-full border border-muted-200 dark:border-muted-700 bg-white dark:bg-muted-800 group-hover:border-primary-500 dark:group-hover:border-primary-500 group-hover:shadow-xl group-hover:shadow-muted-300/30 dark:group-hover:shadow-muted-900/50 transition-all duration-300">
                <h3 class="font-sans text-muted-800 dark:text-muted-100 text-sm font-semibold capitalize">
                  {tag.tag}
                </h3>
                <p class="font-sans text-muted-400 group-hover:text-primary-500 text-sm font-medium">
                  <span>{tag.count}</span>
                </p>
              </div>
            </div>
          </a>
        ))
    }
  </div>
</div>
