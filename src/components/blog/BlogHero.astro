---
import { authorDetail, categoryDetail } from '@config'
import { slug } from 'github-slugger'
import PostCategoryBadges from '@components/blog/PostCategoryBadges.astro'
import Section from '@components/layout/Section.astro'
import Container from '@components/layout/Container.astro'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  frontmatter: CollectionEntry<'blog'>['data']
}

const { frontmatter } = Astro.props

const image = frontmatter.coverImage || frontmatter.socialImage || categoryDetail(frontmatter.categories && frontmatter.categories[0]).socialImage
---

<Section class="bg-muted-100 dark:bg-muted-1000 overflow-hidden">
  <Container>
    <div class="grid grid-cols-12 md:gap-x-10 gap-y-10 pt-6 sm:pt-10">
      <!-- Featured image -->
      <div class="col-span-12 ltablet:col-span-5 ltablet:col-start-2 lg:col-span-5">
        <img src={image} alt="featured image" class="block max-w-full w-full md:w-[540px] md:h-[447px] ltablet:w-[459px] ltablet:h-[380px] object-cover rounded-2xl mx-auto" />
      </div>

      <div class="col-span-12 ltablet:col-span-5 lg:col-span-5 ltablet:col-start-7 lg:col-start-7">
        <div class="h-full flex items-center">
          <div class="w-full max-w-md ptablet:mx-auto">
            <!-- Categories -->
            <div class="mb-4">
              <PostCategoryBadges categories={frontmatter.categories} />
            </div>
            <!-- Title -->
            <h1 class="font-sans text-muted-800 dark:text-white font-bold text-3xl">
              {frontmatter.title}
            </h1>
            <p class="font-sans text-sm text-muted-500 dark:text-muted-400 my-4">
              {frontmatter.description}
            </p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                {
                  frontmatter.author ? (
                    <>
                      <a href={`/authors/${slug(frontmatter.author)}/`}>
                        <img src={authorDetail(frontmatter.author).image} alt={frontmatter.author} class="sm:w-12 sm:h-12 w-10 h-10 rounded-full" />
                      </a>
                      <div class="font-sans text-sm">
                        <a href={`/authors/${slug(frontmatter.author)}/`} class="text-muted-800 dark:text-muted-100 font-medium leading-none hover:text-indigo-600 transition duration-500 ease-in-out">
                          {frontmatter.author}
                        </a>
                        <p class="text-muted-600 dark:text-muted-400 text-xs">published on {frontmatter.publishDate?.toISOString()?.slice(0, 10)}</p>
                      </div>
                    </>
                  ) : null
                }
              </div>
              <div class="font-sans text-xs sm:text-sm text-muted-400">
                <span class="pr-2">—</span>
                <span>{frontmatter.minutesRead}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
