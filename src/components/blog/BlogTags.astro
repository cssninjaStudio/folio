---
import { slug } from 'github-slugger'
export interface Props {
  tags?: string[]
}

const { tags } = Astro.props
---
{tags &&
  <div class="flex flex-row flex-wrap items-start gap-4 lg:gap-2 mt-2">
    {
      tags.map(tag => (
        <a
          href={`/tags/${slug(tag)}/`}
          class="font-sans font-semibold text-xs inline-block py-2 lg:py-1 px-2 rounded-lg no-underline bg-muted-200 dark:bg-muted-800 text-muted-600 dark:text-muted-400"
        >
          #{tag}
        </a>
      ))
    }
  </div>
}
