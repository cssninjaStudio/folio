---
import { Icon } from 'astro-icon'
---

<script is:inline>
  const demos = [
    {
      name: 'Home',
      screenshotLight: '/img/screenshots/home.png',
      screenshotDark: '/img/screenshots/home-dark.png',
      link: '/home',
      new: false,
    },
    {
      name: 'Blog',
      screenshotLight: '/img/screenshots/blog.png',
      screenshotDark: '/img/screenshots/blog-dark.png',
      link: '/blog',
      new: false,
    },
    {
      name: 'Post',
      screenshotLight: '/img/screenshots/post.png',
      screenshotDark: '/img/screenshots/post-dark.png',
      link: '/post',
      new: false,
    },
    {
      name: 'Categories',
      screenshotLight: '/img/screenshots/categories.png',
      screenshotDark: '/img/screenshots/categories-dark.png',
      link: '/categories',
      new: false,
    },
    {
      name: 'Authors',
      screenshotLight: '/img/screenshots/authors.png',
      screenshotDark: '/img/screenshots/authors-dark.png',
      link: '/authors',
      new: false,
    },
    {
      name: 'Author',
      screenshotLight: '/img/screenshots/author.png',
      screenshotDark: '/img/screenshots/author-dark.png',
      link: '/author/Wallace%20Knolder/',
      new: false,
    },
    {
      name: 'Tags',
      screenshotLight: '/img/screenshots/tags.png',
      screenshotDark: '/img/screenshots/tags-dark.png',
      link: '/tags',
      new: false,
    },
    {
      name: 'About',
      screenshotLight: '/img/screenshots/about.png',
      screenshotDark: '/img/screenshots/about-dark.png',
      link: '/about',
      new: false,
    },
    {
      name: 'Error 404',
      screenshotLight: '/img/screenshots/404.png',
      screenshotDark: '/img/screenshots/404-dark.png',
      link: '/404',
      new: false,
    },
  ]

  function renderScreenshots() {
    return {
      screenshots: demos,
    }
  }
</script>

<div class="pb-16">
  <div class="w-full">
    <!--Section title-->
    <div class="w-full max-w-md mb-5">
      <h2
        class="font-sans font-light text-3xl text-muted-800 dark:text-white mb-4"
      >
        Demo Pages
      </h2>
      <p class="font-sans text-muted-500 dark:text-muted-400">
        Foilio ships with elegant and minimalistic pages to help you get started as fast
        as possible, and build an outstanding and memorable blog without effort.
      </p>
    </div>

    <!--Template demos-->
    <div id="template-demos" class="mt-8" x-data="renderScreenshots()">
      <div class="grid md:grid-cols-2 gap-6">
        <template x-for="screenshot in screenshots">
          <a
            x-bind:href="screenshot.link"
            target="_blank"
            class="group block w-full rounded-md bg-white dark:bg-muted-800 border border-muted-200 dark:border-muted-700 p-3 text-center"
          >
            <div class="relative overflow-hidden">
              <div class="relative">
                <img
                  class="block dark:hidden rounded-md"
                  x-bind:src="screenshot.screenshotLight"
                  alt="screenshot light image"
                  width="350"
                  height="198"
                />
                <img
                  class="hidden dark:block rounded-md"
                  x-bind:src="screenshot.screenshotDark"
                  alt="screenshot dark image"
                  width="350"
                  height="198"
                />
                <template x-if="screenshot.new">
                  <span
                    class="block absolute bottom-4 right-4 py-1.5 px-3 font-sans text-xs font-semibold rounded-full bg-rose-500 text-white shadow-xl shadow-rose-500/20"
                  >
                    New
                  </span>
                </template>
              </div>

              <div class="circle-overlay is-landing"></div>
              <div class="w-full pb-3 pt-4 px-1">
                <div class="w-full flex items-center justify-between">
                  <h4
                    class="font-sans font-medium text-muted-800 dark:text-muted-100"
                    x-text="screenshot.name"
                  >
                  </h4>
                  <div class="block">
                    <span
                      class="font-sans text-sm flex items-center pr-1 gap-2 text-muted-500 dark:text-muted-400 group-hover:text-primary-500 transition-colors duration-300"
                    >
                      <span>Go to demo</span>
                      <Icon
                        name="lucide:arrow-right"
                        class="w-4 h-4 group-hover:text-primary-500 group-hover:translate-x-1 transition-all duration-300"
                      />
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </template>
      </div>
    </div>
  </div>
</div>
