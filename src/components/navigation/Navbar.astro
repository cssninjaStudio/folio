---
import { Icon } from 'astro-icon'
import { NavigationLinks, Logo } from '@config'
import Container from '@components/layout/Container.astro'
import NavbarSearch from '@components/navigation/NavbarSearch.astro'
import PageFindSearch from '@components/navigation/PageFindSearch.astro'
import NavbarTheme from '@components/navigation/NavbarTheme.astro'
import SVGImg from '@components/svgimg.astro'
---

<script is:inline>
  function navbar() {
    return {
      scrolled: false,
      height: 60,
      mobileOpen: false,
      searchOpen: false,
      scroll() {
        let scrollValue = window.scrollY
        if (scrollValue >= this.height) {
          this.scrolled = true
        } else {
          this.scrolled = false
        }
      },
    }
  }
</script>
<nav
  x-data="navbar()"
  x-on:scroll.window="scroll()"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 ease-in-out"
  x-bind:class="[
    scrolled ? 'bg-white dark:bg-muted-800 shadow-lg shadow-muted-400/10 dark:shadow-muted-800/10' : ''
  ]"
>
  <div class="w-full px-4 lg:px-6">
    <Container>
      <div
        class="relative flex items-center ltablet:justify-start justify-between h-16"
      >
        <div
          class="flex-1 ltablet:flex-none lg:flex-none flex items-center lg:hidden"
        >
          <!-- Mobile menu button-->
          <button
            type="button"
            x-on:click="mobileOpen = !mobileOpen"
            class="inline-flex items-center justify-center p-2 rounded-md text-muted-700 dark:text-muted-100"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <Icon
              x-bind:class="{'hidden': mobileOpen, 'block': !mobileOpen }"
              class="block h-6 w-6"
              aria-hidden="true"
              pack="heroicons-outline"
              name="menu"
            />
            <Icon
              x-bind:class="{'block': mobileOpen, 'hidden': !mobileOpen }"
              class="hidden h-6 w-6"
              aria-hidden="true"
              pack="heroicons-outline"
              name="x"
            />
          </button>
          <!-- Mobile search -->
          <button
            class="h-16 w-16 items-center justify-center text-muted-400"
            x-bind:class="searchOpen ? 'hidden' : 'flex ptablet:flex sm:hidden'"
            x-on:click="searchOpen = true"
          >
            <Icon name="lucide:search" class="w-12 h-12" />
          </button>
          <button
            class="h-16 w-16 items-center justify-center text-muted-400"
            x-bind:class="!searchOpen ? 'hidden' : 'flex ptablet:flex sm:hidden'"
            x-on:click="searchOpen = false"
          >
            <Icon name="lucide:eye-off" class="w-5 h-5" />
          </button>
        </div>
        <div
          class="flex-1 ltablet:flex-none lg:flex-none flex items-center justify-center lg:items-stretch lg:justify-start ltablet:ml-6"
        >
          <div class="flex-shrink-0 flex items-center">
            <SVGImg
              class="block h-9 w-9 lg:h-10 sm:w-10"
              src={Logo}
              alt="Logo"
            />
          </div>
          <div class="hidden lg:flex items-center lg:ml-6">
            <div class="h-9 flex gap-x-4">
              {
                NavigationLinks.map(item => (
                  <a
                    href={item.href}
                    class={
                      (item.href.length > 0 &&
                      Astro.url.toString().includes(item.href)
                        ? 'bg-primary-500/10 text-primary-500 '
                        : 'hover:bg-muted-200/70 dark:hover:bg-muted-700 text-muted-500 hover:text-muted-800 dark:text-muted-400 dark:hover:text-muted-100 ') +
                      'h-9 flex items-center justify-center px-4 font-sans text-sm rounded-lg transition-colors duration-300'
                    }
                    aria-current={
                      item.href.length > 0 &&
                      Astro.url.toString().includes(item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        <div
          class="flex-1 ltablet:flex-none lg:flex-none ltablet:ml-auto lg:ml-auto flex items-center ptablet:justify-end ltablet:justify-end lg:justify-end gap-4 sm:static"
        >
          <div
            class="relative group"
            x-bind:class="searchOpen ? '!fixed top-16 left-0 h-16 px-5 w-full flex sm:hidden ptablet:flex items-center -m-1 bg-white dark:bg-muted-800' : 'hidden ltablet:block lg:block'"
          >
            <div
              class="absolute z-20 top-3 left-5 ltablet:top-0 ltablet:left-0 lg:top-0 lg:left-0 h-10 w-10 flex justify-center items-center text-muted-400 group-focus-within:text-violet-500 transition-colors duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                aria-hidden="true"
                role="img"
                class="h-4 w-4"
                width="32"
                height="32"
                preserveAspectRatio="xMidYMid meet"
                viewBox="0 0 24 24"
                ><g
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  ><circle cx="11" cy="11" r="8"></circle><path
                    d="m21 21l-4.35-4.35"></path></g
                ></svg
              >
            </div>
            <PageFindSearch />
          </div>
          <NavbarTheme />

          <!-- Right nav -->
        </div>
      </div>
    </Container>
  </div>

  <!-- Mobile menu, show/hide based on menu state. -->
  <div
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition-all ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-x-full"
    x-transition:enter-end="opacity-100 translate-x-0"
    x-transition:leave="transition-all ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-x-0"
    x-transition:leave-end="opacity-0 -translate-x-full"
    class="fixed top-0 left-0 h-screen w-72 z-50 b-white"
    id="mobile-menu"
  >
    <div
      class="h-full flex flex-col border-r border-muted-200 dark:border-muted-700 bg-white dark:bg-muted-800 shadow-lg shadow-muted-300/30 dark:shadow-muted-900/20"
    >
      <div class="h-16 w-full flex items-center justify-between px-6">
        <div class="flex items-center ga-2">
          <a>
            <div class="flex-shrink-0 flex items-center">
              <SVGImg class="block h-10 w-10" src={Logo} alt="Logo" />
            </div>
          </a>
        </div>
        <button
          type="button"
          x-on:click="mobileOpen = !mobileOpen"
          class="inline-flex items-center justify-center p-2 rounded-md text-primary-500"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Close mobile menu</span>
          <Icon
            x-bind:class="{'block': mobileOpen, 'hidden': !mobileOpen }"
            class="hidden h-6 w-6"
            aria-hidden="true"
            pack="heroicons-outline"
            name="x"
          />
        </button>
      </div>
      <div class="h-[calc(100%_-_64px)] overflow-y-auto slimscroll">
        <div class="flex flex-col gap-4 p-6">
          {
            NavigationLinks.map(item => (
              <a
                href={item.href}
                class:list={[
                  item.href.length > 0 &&
                  Astro.url.toString().includes(item.href)
                    ? 'bg-primary-500/20 text-primary-500'
                    : 'text-muted-500 dark:text-muted-400',
                  ' font-sans py-3 px-4 rounded-lg',
                ]}
                aria-current={
                  item.href.length > 0 &&
                  Astro.url.toString().includes(item.href)
                    ? 'page'
                    : undefined
                }
              >
                {item.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</nav>
