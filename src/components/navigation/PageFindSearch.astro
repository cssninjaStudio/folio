---
import '@pagefind/default-ui/css/ui.css'
import { join } from 'node:path'
import type { Props } from './Search.js'

const { id, className } = Astro.props as Props
const bundlePath = join(import.meta.env.BASE_URL, '_pagefind/')
const divProps = {
  ...(id ? { id } : {}),
  ...(className ? { class: className } : {}),
}
---

<div {...divProps} data-pagefind-ui data-bundle-path={bundlePath}></div>
<script>
  import { PagefindUI } from '@pagefind/default-ui'
  window.addEventListener('DOMContentLoaded', () => {
    const allSelector = '[data-pagefind-ui]'
    for (const el of document.querySelectorAll(allSelector)) {
      const elSelector = [
        ...(el.id ? [`#${el.id}`] : []),
        ...[...el.classList.values()].map(c => `.${c}`),
        allSelector,
      ].join('')
      const bundlePath = el.getAttribute('data-bundle-path')
      new PagefindUI({
        element: elSelector,
        bundlePath,
      })
    }
  })
</script>

<style is:global>
  :root {
    --pagefind-ui-primary: var(--color-primary-500);
    --pagefind-ui-text: var(--color-muted-800);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font: Inter, sans-serif;
    --pagefind-ui-background: var(--color-white);
  }

  .dark {
    --pagefind-ui-background: var(--color-muted-800);
    --pagefind-ui-border: var(--color-muted-700);
    --pagefind-ui-text: var(--color-muted-200);
  }

  .pagefind-ui__form::before {
    display: none !important;
  }

  .pagefind-ui__search-input {
    border-radius: 0.75rem !important;
    line-height: 1.25rem !important;
    font-size: 0.875rem !important;
    font-weight: normal !important;
    font-family: Inter, sans-serif !important;
    height: 2.5rem !important;
    max-width: 244px;
  }

  .pagefind-ui__search-clear {
    height: 2.5rem !important;
    top: 0 !important;
    right: 0 !important;
    background: none !important;
  }

  .pagefind-ui__drawer {
    position: absolute;
    width: 100%;
    right: 0;
    z-index: 10;
    min-width: 380px;
  }

  .pagefind-ui__results-area {
    background: var(--pagefind-ui-background);
    border: 1px solid var(--pagefind-ui-border);
    border-radius: 0.35rem;
    margin-top: 0.5rem !important;
    box-shadow: -1px 3px 10px 0 rgb(0 0 0 / 6%) !important;
  }

  .pagefind-ui__message {
    padding: 1rem !important;
    font-family: Inter, sans-serif !important;
  }

  .pagefind-ui__results {
    max-height: 340px;
    overflow-y: auto;
  }

  .pagefind-ui__results::-webkit-scrollbar {
    width: 6px !important;
  }

  .pagefind-ui__results::-webkit-scrollbar-thumb {
    border-radius: 0.75rem !important;
    background: rgba(0, 0, 0, 0.1) !important;
  }

  .pagefind-ui__result {
    padding-right: 1.5rem !important;
  }

  .pagefind-ui__button {
    margin: 1rem !important;
    width: calc(100% - 2rem) !important;
    font-family: Inter, sans-serif !important;
    font-weight: 500 !important;
    height: 44px !important;
  }

  @media only screen and (max-width: 767px) {
    .pagefind-ui,
    .pagefind-ui__form {
      width: 100% !important;
    }

    .pagefind-ui__search-input {
      max-width: 100%;
    }

    .pagefind-ui__drawer {
      min-width: 100%;
    }

    div[data-pagefind-ui] {
      width: 100% !important;
    }
  }

  @media only screen and (min-width: 768px) and (max-width: 1024px) and (orientation: portrait) {
    .pagefind-ui,
    .pagefind-ui__form {
      width: 100% !important;
    }

    .pagefind-ui__search-input {
      max-width: 100%;
    }

    div[data-pagefind-ui] {
      width: 100% !important;
    }
  }
</style>
