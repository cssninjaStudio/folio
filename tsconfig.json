{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "types": ["astro/client"],
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@svg/*": ["src/svg/*"],
      "@images/*": ["src/images/*"],
      "@config": ["src/config.ts"]
    }
  }
}
